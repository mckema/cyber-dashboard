# Copy to .env (`exploit-watch bootstrap` does this for you). .env is gitignored.
# Values are read by Docker Compose too: do not use `$` in values, and do not quote them.

# Wiki.js base URL. Inside compose the job overrides this with http://wiki:3000.
WIKI_BASE=http://localhost:3000
# Numeric id of the Cyber-Exploit-Watch page. Written by `exploit-watch bootstrap`.
WIKI_PAGE_ID=
# Wiki.js API key of the least-privilege "exploit-watch" group. Written by `exploit-watch bootstrap`.
WIKIJS_API_KEY=
# Local admin account used only by `exploit-watch bootstrap` (setup, API key, page CSS).
WIKI_ADMIN_EMAIL=admin@example.com
# Admin password. Leave empty and `exploit-watch bootstrap` generates one on first run.
WIKI_ADMIN_PASSWORD=
# Optional free NVD key; lifts the NVD rate limit (5 req/30 s without it).
NVD_API_KEY=
# Optional GitHub token (no scopes needed); lifts the advisories limit 60 -> 5000 req/h.
GITHUB_TOKEN=
# Seconds between job runs (`exploit-watch run --every`); 21600 = every 6 hours.
INTERVAL_SECONDS=21600
# Optional User-Agent for feed requests; use a team/contact string, not a personal email.
USER_AGENT=
# Triage (FR-A2/A3). Component list for the matcher; default is the sample list.
# COMPONENTS_FILE=stack/job/components.sample.toml
# Where tickets go: off | live. Empty values below fall back to the compose
# defaults, which point the job at the local linear-mock service.
# LINEAR_MODE=live
# Linear GraphQL endpoint. Real Linear: https://api.linear.app/graphql
LINEAR_API_URL=
# Linear credential: a personal API key (lin_api_…, sent bare) or an OAuth
# access token, e.g. from an OAuth app's client_credentials grant (sent as
# "Bearer <token>"). The job does not refresh OAuth tokens: replace the value
# before it expires (client_credentials tokens last 30 days).
LINEAR_API_KEY=
# Team id whose Triage inbox receives issues.
LINEAR_TEAM_ID=
# Report service (`report-serve`, local lab). Address of the service as the browser
# sees it; the page's "Refresh & download" link points there.
SERVE_PUBLIC_URL=http://localhost:8090
# Seconds after a refresh during which a click gets the last PDF without a new refresh.
SERVE_COOLDOWN_SECONDS=60
# Seconds a click waits for a running job to release state/run.lock before it gets the last PDF.
SERVE_LOCK_WAIT_SECONDS=90
