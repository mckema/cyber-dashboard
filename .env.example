# exploit-watch configuration for the local Docker Compose lab.
#
#   cp .env.example .env      # .env is gitignored; never commit real values
#
# Docker Compose reads this file: no quotes, no `$` in values.
# Commented lines show the default. Empty secrets are filled by `bootstrap`
# or left empty to disable the feature. Full reference: README.md#configuration.

# --- Wiki.js -------------------------------------------------------------------
# Default: the local dev-wiki service. Set to publish to another Wiki.js.
# WIKI_BASE=http://dev-wiki:3000
# Written by `exploit-watch bootstrap`.
WIKI_PAGE_ID=
WIKIJS_API_KEY=
# Page path (locale en); the bot may write in its folder. Used by `bootstrap`.
# WIKI_PAGE_PATH=security/cyber-threat-dashboard
# Move an existing page from this path to WIKI_PAGE_PATH (bootstrap, optional).
# WIKI_PAGE_OLD_PATH=
# Page URL as the browser sees it (links in review issues, redirect after sync).
# WIKI_PUBLIC_URL=http://localhost:3000/en/security/cyber-threat-dashboard
# WIKI_ASSET_FOLDER=exploit-watch

# Admin account, used by `bootstrap` only. Empty password: generated on first run.
WIKI_ADMIN_EMAIL=admin@example.com
WIKI_ADMIN_PASSWORD=

# --- Feeds ---------------------------------------------------------------------
# Optional; raise the API rate limits.
NVD_API_KEY=
GITHUB_TOKEN=
# Team or service contact, not a personal address.
# USER_AGENT=exploit-watch/0.3
# COMPONENTS_FILE=components.sample.toml

# --- Linear (triage) -------------------------------------------------------------
# off: no tickets. live: needs a credential and LINEAR_TEAM_ID.
# LINEAR_MODE=off
# LINEAR_API_URL=https://api.linear.app/graphql
# Credential, either:
#   OAuth app (preferred; the job requests and renews its own token)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
#   or a personal API key / access token (not renewed by the job)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# --- Reports -------------------------------------------------------------------
# lab | test | production. Marks report PDFs LAB DATA / TEST DATA / none.
# EW_ENVIRONMENT=lab
# REVIEW_SAMPLE_SIZE=10
# Organisation named in the PDFs (empty: none), distribution line, TLP marking.
# REPORT_ORG=
# REPORT_AUDIENCE=Internal
# REPORT_TLP=TLP:AMBER
# Review reminder of the monthly close: Linear user id, business days after month end.
REPORT_REVIEW_ASSIGNEE_ID=
REPORT_REVIEW_DUE_DAYS=

# --- Runtime -------------------------------------------------------------------
# Seconds between runs of the job loop (21600 = 6 h).
# INTERVAL_SECONDS=21600
# State directory inside the container. Use a separate one per tracker,
# e.g. /app/state/linear-test when LINEAR_MODE=live.
# STATE_DIR=/app/state

# --- dev-report-serve (lab only) ------------------------------------------------------
# SERVE_PUBLIC_URL=http://localhost:8090
# SERVE_COOLDOWN_SECONDS=60
# SERVE_LOCK_WAIT_SECONDS=90
